/* ===== 基础变量定义 ===== */
:root
  --radius-large: 1rem
  --content-delay: 150ms

/* ===== 主题相关变量 ===== */
:root
  --hue: 200
  --primary: #b3b3b3
  --primary: oklch(0.70 0 var(--hue))
  --page-bg: #f2f2f2
  --page-bg: oklch(0.95 0 var(--hue))
  --card-bg: white
  --card-bg-transparent: unquote("rgb(255 255 255 / var(--card-transparent-opacity, 0.6))")
  
  --btn-content: #8c8c8c
  
  --btn-content: oklch(0.55 0 var(--hue))
  --btn-regular-bg: #f2f2f2
  --btn-regular-bg: oklch(0.95 0 var(--hue))
  --btn-regular-bg-hover: #e6e6e6
  --btn-regular-bg-hover: oklch(0.9 0 var(--hue))
  --btn-regular-bg-active: #d9d9d9
  --btn-regular-bg-active: oklch(0.85 0 var(--hue))
  
  --btn-plain-bg-hover: #f2f2f2
  
  --btn-plain-bg-hover: oklch(0.95 0 var(--hue))
  --btn-plain-bg-active: #fafafa
  --btn-plain-bg-active: oklch(0.98 0 var(--hue))
  
  --btn-card-bg-hover: #fafafa
  
  --btn-card-bg-hover: oklch(0.98 0 var(--hue))
  --btn-card-bg-active: #e6e6e6
  --btn-card-bg-active: oklch(0.9 0 var(--hue))
  
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  
  --deep-text: #404040
  
  --deep-text: oklch(0.25 0 var(--hue))
  --title-active: #999999
  --title-active: oklch(0.6 0 var(--hue))
  
  --line-divider: rgba(0, 0, 0, 0.08)
  --line-color: rgba(0, 0, 0, 0.1)
  --meta-divider: rgba(0, 0, 0, 0.2)
  --content-meta: rgba(0, 0, 0, 0.7)
  
  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --muted: #ededed
  --muted: oklch(0.93 0 var(--hue))
  --selection-bg: #e6e6e6
  --selection-bg: oklch(0.90 0 var(--hue))
  --codeblock-bg: #2b2b2b
  --codeblock-bg: oklch(0.17 0 var(--hue))
  --codeblock-topbar-bg: #4d4d4d
  --codeblock-topbar-bg: oklch(0.3 0 var(--hue))
  
  --license-block-bg: rgba(0, 0, 0, 0.03)
  
  --link-underline: #ededed
  
  --link-underline: oklch(0.93 0 var(--hue))
  --link-hover: #f2f2f2
  --link-hover: oklch(0.95 0 var(--hue))
  --link-active: #e6e6e6
  --link-active: oklch(0.90 0 var(--hue))
  
  --float-panel-bg: white
  
  --scrollbar-bg-light: rgba(0, 0, 0, 0.4)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.5)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.6)
  
  --scrollbar-bg-dark: rgba(255, 255, 255, 0.4)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.5)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.6)
  
  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)
  
  --display-light-icon: 1
  --display-dark-icon: 0
  
  --admonitions-color-tip: #4db8a8
  --admonitions-color-tip: oklch(0.7 0.14 180)
  --admonitions-color-note: #6a8fd4
  --admonitions-color-note: oklch(0.7 0.14 250)
  --admonitions-color-important: #c47ad4
  --admonitions-color-important: oklch(0.7 0.14 310)
  --admonitions-color-warning: #d4c47a
  --admonitions-color-warning: oklch(0.7 0.14 60)
  --admonitions-color-caution: #d47a4a
  --admonitions-color-caution: oklch(0.6 0.2 25)
  
  /* TOC相关变量 */
  --toc-badge-bg: #e6e6e6
  --toc-badge-bg: oklch(0.9 0 var(--hue))
  --toc-btn-hover: #ebebeb
  --toc-btn-hover: oklch(0.92 0 var(--hue))
  --toc-btn-active: #e6e6e6
  --toc-btn-active: oklch(0.90 0 var(--hue))
  --toc-indicator-bg: #ebebeb
  --toc-indicator-bg: oklch(0.92 0 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: #b3b3b3
  --toc-item-active: oklch(0.70 0 var(--hue))

  /* Live2D 消息框变量 */
  --l2d-msg-bg: #b3b3b3
  --l2d-msg-bg: oklch(0.7 0 var(--hue))

  /* 主题色选择条渐变 */
  --color-selection-bar: linear-gradient(to right, #e0b3b3, #e0c4b3, #e0d4b3, #d4e0b3, #b3e0b3, #b3e0c4, #b3e0d4, #b3d4e0, #b3c4e0, #c4b3e0, #d4b3e0, #e0b3d4, #e0b3b3)
  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360)), #e0d4b3, oklch(0.80 0.10 60), #d4e0b3, oklch(0.80 0.10 90), #b3e0b3, oklch(0.80 0.10 120), #b3e0c4, oklch(0.80 0.10 150), #b3e0d4, oklch(0.80 0.10 180), #b3d4e0, oklch(0.80 0.10 210), #b3c4e0, oklch(0.80 0.10 240), #c4b3e0, oklch(0.80 0.10 270), #d4b3e0, oklch(0.80 0.10 300), #e0b3d4, oklch(0.80 0.10 330), #e0b3b3, oklch(0.80 0.10 360))

/* 卡片风格跟随主题色相 */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: #ffffff
  --card-bg: oklch(1 0 var(--hue))

/* 暗色主题变量 */
:root.dark
  --primary: #bfbfbf
  --primary: oklch(0.75 0 var(--hue))
  --page-bg: #292929
  --page-bg: oklch(0.16 0 var(--hue))
  --card-bg: #3b3b3b
  --card-bg: oklch(0.23 0 var(--hue))
  --card-bg-transparent: unquote("rgb(23 23 23 / var(--card-transparent-opacity, 0.6))")
  
  --btn-content: #bfbfbf
  
  --btn-content: oklch(0.75 0 var(--hue))
  --btn-regular-bg: #545454
  --btn-regular-bg: oklch(0.33 0 var(--hue))
  --btn-regular-bg-hover: #616161
  --btn-regular-bg-hover: oklch(0.38 0 var(--hue))
  --btn-regular-bg-active: #6e6e6e
  --btn-regular-bg-active: oklch(0.43 0 var(--hue))
  
  --btn-plain-bg-hover: #4d4d4d
  
  --btn-plain-bg-hover: oklch(0.30 0 var(--hue))
  --btn-plain-bg-active: #454545
  --btn-plain-bg-active: oklch(0.27 0 var(--hue))
  
  --btn-card-bg-hover: #4d4d4d
  
  --btn-card-bg-hover: oklch(0.3 0 var(--hue))
  --btn-card-bg-active: #595959
  --btn-card-bg-active: oklch(0.35 0 var(--hue))
  
  --line-divider: rgba(255, 255, 255, 0.08)
  --line-color: rgba(255, 255, 255, 0.1)
  --meta-divider: rgba(255, 255, 255, 0.2)
  --content-meta: rgba(255, 255, 255, 0.6)
  
  --muted: #404040
  
  --muted: oklch(0.25 0 var(--hue))
  --selection-bg: #666666
  --selection-bg: oklch(0.40 0 var(--hue))
  --codeblock-bg: #2b2b2b
  --codeblock-bg: oklch(0.17 0 var(--hue))
  --codeblock-topbar-bg: #1f1f1f
  --codeblock-topbar-bg: oklch(0.12 0 var(--hue))
  
  --license-block-bg: var(--codeblock-bg)
  
  --link-underline: #666666
  
  --link-underline: oklch(0.40 0 var(--hue))
  --link-hover: #666666
  --link-hover: oklch(0.40 0 var(--hue))
  --link-active: #595959
  --link-active: oklch(0.35 0 var(--hue))
  
  --float-panel-bg: #303030
  
  --float-panel-bg: oklch(0.19 0 var(--hue))
  
  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)
  
  --display-light-icon: 0
  --display-dark-icon: 1
  
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  
  /* TOC相关变量 - 暗色主题 */
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: #474747
  --toc-btn-hover: oklch(0.28 0 var(--hue))
  --toc-btn-active: #525252
  --toc-btn-active: oklch(0.32 0 var(--hue))
  --toc-indicator-bg: #474747
  --toc-indicator-bg: oklch(0.28 0 var(--hue))
  --toc-item-active: #595959
  --toc-item-active: oklch(0.35 0 var(--hue))

  /* Live2D 消息框变量 - 暗色主题 */
  --l2d-msg-bg: #595959
  --l2d-msg-bg: oklch(0.35 0 var(--hue))

  /* 主题色选择条渐变 - 暗色主题 */
  --color-selection-bar: linear-gradient(to right, #b38080, #b38f80, #b39f80, #8fb380, #80b380, #80b38f, #80b39f, #809fb3, #808fb3, #8f80b3, #9f80b3, #b3809f, #b38080)
  --color-selection-bar: linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360)), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/* ===== 响应式断点变量 ===== */
:root
  /* 断点定义 */
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px
  
  /* 容器宽度 */
  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 1024px
  --container-xl: 1280px
  --container-2xl: 1536px

/* ===== 动画变量 ===== */
:root
  /* 缓动函数 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)
  
  /* 动画时长 */
  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms
  
  /* 动画延迟 */
  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  /* 基础间距 */
  --spacing-xs: 0.25rem    /* 4px */
  --spacing-sm: 0.5rem     /* 8px */
  --spacing-md: 0.75rem    /* 12px */
  --spacing-lg: 1rem       /* 16px */
  --spacing-xl: 1.25rem    /* 20px */
  --spacing-2xl: 1.5rem    /* 24px */
  --spacing-3xl: 2rem      /* 32px */
  --spacing-4xl: 2.5rem    /* 40px */
  --spacing-5xl: 3rem      /* 48px */
  
  /* 组件间距 */
  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)
  
  /* 侧边栏宽度 */
  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 320px

/* ===== 阴影变量 ===== */
:root
  /* 基础阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05)
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1)
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1)
  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.1)
  --shadow-2xl: 0 25px 50px rgba(0, 0, 0, 0.25)
  
  /* 特殊阴影 */
  --shadow-navbar: 0 4px 16px rgba(0, 0, 0, 0.1)
  --shadow-navbar-dark: 0 4px 16px rgba(0, 0, 0, 0.2)
  --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.15)
  --shadow-button-dark: 0 4px 12px rgba(255, 255, 255, 0.1)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem     /* 4px */
  --radius-md: 0.375rem    /* 6px */
  --radius-lg: 0.5rem      /* 8px */
  --radius-xl: 0.75rem     /* 12px */
  --radius-2xl: 1rem       /* 16px */
  --radius-3xl: 1.5rem     /* 24px */
  --radius-full: 9999px

/* ===== 透明度变量 ===== */
:root
  --opacity-0: 0
  --opacity-5: 0.05
  --opacity-10: 0.1
  --opacity-20: 0.2
  --opacity-25: 0.25
  --opacity-30: 0.3
  --opacity-40: 0.4
  --opacity-50: 0.5
  --opacity-55: 0.55
  --opacity-60: 0.6
  --opacity-70: 0.7
  --opacity-75: 0.75
  --opacity-80: 0.8
  --opacity-85: 0.85
  --opacity-90: 0.9
  --opacity-95: 0.95
  --opacity-100: 1

/* ===== 模糊效果变量 ===== */
:root
  --blur-sm: 4px
  --blur-md: 8px
  --blur-lg: 12px
  --blur-xl: 16px
  --blur-2xl: 20px
  --blur-3xl: 24px

/* ===== 变换变量 ===== */
:root
  /* 平移 */
  --translate-xs: 0.125rem   /* 2px */
  --translate-sm: 0.25rem     /* 4px */
  --translate-md: 0.5rem      /* 8px */
  --translate-lg: 0.75rem     /* 12px */
  --translate-xl: 1rem        /* 16px */
  --translate-2xl: 1.5rem      /* 24px */
  --translate-3xl: 2rem       /* 32px */
  
  /* 缩放 */
  --scale-95: 0.95
  --scale-98: 0.98
  --scale-100: 1
  --scale-105: 1.05
  --scale-110: 1.1

/* ===== 层级变量 ===== */
:root
  --z-dropdown: 1000
  --z-sticky: 1020
  --z-fixed: 1030
  --z-modal-backdrop: 1040
  --z-modal: 1050
  --z-popover: 1060
  --z-tooltip: 1070
  --z-toast: 1080
  --z-navbar: 20
  --z-banner: 10
  --z-content: 30

/* ===== 性能优化变量 ===== */
:root
  /* GPU加速 */
  --gpu-transform: translateZ(0)
  --gpu-backface: hidden
  
  /* 动画性能 */
  --animation-fill-mode: both
  --animation-timing: var(--ease-standard)
  --animation-duration: var(--duration-medium)

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)
    --sidebar-width: var(--sidebar-width-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)
    --sidebar-width: var(--sidebar-width-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
    --sidebar-width: var(--sidebar-width-desktop)
